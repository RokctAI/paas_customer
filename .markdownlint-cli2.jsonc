{
  // Repo-local config for the shared Code Quality workflow's Markdown Lint
  // job (markdownlint-cli2 runs in this checkout with CLI globs only, so
  // this file is the config it picks up). Default rules stay enabled for
  // everything not listed below. Same mechanism as supacharge's config.
  "ignores": [
    // Composer-generated SDK compliance docs. The Clean HEAD gate requires
    // these files to match the composer's output byte-for-byte, so they can
    // never be hand-edited to satisfy authoring rules (e.g. MD022 blanks
    // around headings emitted by the docs generator).
    "docs/api/**"
  ]
}
